{
  "name": "gym-noob",
  "private": true,
  "version": "1.0.0",
  "description": "Gym Noob — Ghidul complet al începătorului absolut. PWA de antrenament în limba română.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix server test",
    "test:watch": "vitest",
    "api:dev": "node server/src/main.ts",
    "smoke": "node scripts/smoke.mjs",
    "capturi": "node scripts/screenshots.mjs",
    "mascota": "node scripts/mascota.mjs",
    "iconite": "node scripts/iconite.mjs",
    "deploy": "npm test && npm run build && git add dist && git commit -m \"Publicare: build nou in dist\" && git push"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/rammetto-one": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.62.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
